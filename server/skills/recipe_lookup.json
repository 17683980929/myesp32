{
  "name": "recipe_lookup",
  "type": "docs",
  "dir": "data/recipes",
  "description": "查家常菜谱（187 道：荤菜、素菜、汤羹、主食、水产、甜品、饮品）。用户问「番茄炒蛋怎么做」「红烧肉放多少糖」「宫保鸡丁要什么材料」「今天做什么菜」「XX 怎么烧」时调用。返回原料、用量和步骤。必须依据返回的菜谱回答，没查到就说没查到，不要凭记忆编菜谱或改用量。",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "菜名或主要食材，例如「番茄炒蛋」「红烧肉」「土豆」「鸡蛋羹」"
      }
    },
    "required": ["query"]
  },
  "maxEntries": 2,
  "entryChars": 1400,
  "minScore": 8,
  "headMatch": true,
  "synonyms": {
    "番茄": ["西红柿"],
    "西红柿": ["番茄"],
    "土豆": ["马铃薯"],
    "马铃薯": ["土豆"],
    "地瓜": ["红薯"],
    "花菜": ["菜花"],
    "包菜": ["卷心菜"],
    "豆角": ["四季豆"],
    "柿子椒": ["青椒"],
    "炒蛋": ["炒鸡蛋"],
    "蛋炒饭": ["炒饭"],
    "鸡翅": ["鸡翅中"]
  }
}
