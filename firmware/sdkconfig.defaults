# MyEsp32 编译默认值

CONFIG_IDF_TARGET="esp32s3"

# CPU 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 16MB QIO 80MHz Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 自定义分区表
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# 控制台走 USB Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 主任务栈给大一点（Lua/渲染要用）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# FreeRTOS tick 1000Hz，按键响应更顺
CONFIG_FREERTOS_HZ=1000

# C++ 异常/RTTI 关掉省空间
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# 事件循环任务栈
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ── 语音唤醒词（ESP-SR WakeNet9，中文"小宇同学"）────────────────────────
# 模型从 flash 的 model 分区读；只启用"小宇同学"一个唤醒词
# （喊"小鱼同学"即可触发——同音只差声调；NSN/VADN 用 WebRTC 版、MultiNet 全关）
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_WN_WN9_XIAOYUTONGXUE_TTS2=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# ── BLE（NimBLE，仅从机/广播；语音开关，不做业务协议）──────────────────
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=64
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_SVC_DIS=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# 内部 RAM 很紧：把控制器/主机的缓冲区压到最小
CONFIG_BT_CTRL_BLE_MAX_ACT=1
CONFIG_BT_CTRL_BLE_STATIC_ACL_TX_BUF_NB=2
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=4
CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_MSYS_BUF_SIZE=256
CONFIG_BT_NIMBLE_MAX_CCCDS=4
